# Salin file ini jadi .env untuk pengaturan lokal (opsional, default sudah cocok untuk XAMPP).
# Di Render, isi nilai-nilai ini lewat tab "Environment" pada Web Service backend.

# Kredensial MySQL. Untuk deploy, isi dengan kredensial dari provider MySQL
# terkelola (Aiven, PlanetScale, Railway, Clever Cloud, dll), BUKAN localhost.
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=posturography

# Render otomatis mengisi PORT sendiri, tidak perlu diisi manual saat deploy.
PORT=5000
